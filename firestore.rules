rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDoctor() {
      return request.auth != null
        && request.auth.token.role == 'doctor'
        && request.auth.token.get('forcePasswordChange', false) != true
        && request.auth.token.doctorId is string;
    }
    function isClinicAdmin() {
      return request.auth != null && request.auth.token.role == 'admin'
        && request.auth.token.get('forcePasswordChange', false) != true;
    }
    function isManager() {
      return request.auth != null && request.auth.token.role == 'manager'
        && request.auth.token.get('forcePasswordChange', false) != true;
    }
    function isClinicTeam() { return isDoctor() || isClinicAdmin(); }
    function isClinicStaff() { return isClinicTeam() || isManager(); }
    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function isScheduleSession(value) {
      return value is map
        && value.keys().hasOnly(['weekday', 'start', 'end'])
        && value.weekday is int && value.weekday >= 0 && value.weekday <= 6
        && isTime(value.start) && isTime(value.end) && value.start < value.end;
    }
    function isExceptionSession(value) {
      return value is map
        && value.keys().hasOnly(['start', 'end'])
        && isTime(value.start) && isTime(value.end) && value.start < value.end;
    }
    function validScheduleSessions(value) {
      return value is list && value.size() <= 14
        && (value.size() < 1 || isScheduleSession(value[0]))
        && (value.size() < 2 || isScheduleSession(value[1]))
        && (value.size() < 3 || isScheduleSession(value[2]))
        && (value.size() < 4 || isScheduleSession(value[3]))
        && (value.size() < 5 || isScheduleSession(value[4]))
        && (value.size() < 6 || isScheduleSession(value[5]))
        && (value.size() < 7 || isScheduleSession(value[6]))
        && (value.size() < 8 || isScheduleSession(value[7]))
        && (value.size() < 9 || isScheduleSession(value[8]))
        && (value.size() < 10 || isScheduleSession(value[9]))
        && (value.size() < 11 || isScheduleSession(value[10]))
        && (value.size() < 12 || isScheduleSession(value[11]))
        && (value.size() < 13 || isScheduleSession(value[12]))
        && (value.size() < 14 || isScheduleSession(value[13]));
    }
    function validExceptionSessions(value) {
      return value is list && value.size() <= 4
        && (value.size() < 1 || isExceptionSession(value[0]))
        && (value.size() < 2 || isExceptionSession(value[1]))
        && (value.size() < 3 || isExceptionSession(value[2]))
        && (value.size() < 4 || isExceptionSession(value[3]));
    }
    // Public catalog records contain no patient data and power the demo booking flow.
    match /branches/{branchId} {
      // This collection is deliberately limited to public clinic details.
      allow read: if true;
      allow write: if false;
    }
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if false;
    }
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false;
    }
    match /doctorSchedules/{doctorId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /scheduleExceptions/{exceptionId} {
      allow read: if isClinicStaff();
      allow create, update, delete: if false;
    }
    // A separate public slot index contains no patient data. It powers the booking
    // calendar, but its locks are created only by trusted server transactions.
    match /appointmentSlots/{slotId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    // Appointment writes—including staff transitions—are callable/Admin-SDK only.
    // Rules cannot safely enforce a state machine or cross-document lock by themselves.
    match /appointments/{appointmentId} {
      allow read: if isClinicStaff()
        || (request.auth != null && resource.data.patientId == request.auth.uid);
      allow create, update, delete: if false;
    }
    // Administrative audit and notification/outbox data are server-owned. Their
    // explicit deny rules make this boundary resilient to future catch-all edits.
    match /auditLogs/{logId} { allow read, write: if false; }
    match /notifications/{notificationId} { allow read, write: if false; }
    match /rateLimits/{rateLimitId} { allow read, write: if false; }
    match /counters/{counterId} { allow read, write: if false; }
    match /patientDirectory/{patientId} { allow read, write: if false; }
    // The public booking calendar reads the doctor-declared recurring hours.
    match /clinicSchedules/{doctorId} {
      allow read: if true;
      allow create, update, delete: if isClinicAdmin()
        || (isDoctor() && doctorId == request.auth.token.doctorId);
    }
    // This is an administrative directory only. It does not grant Firebase Authentication
    // access or custom claims; those remain a trusted server-side responsibility.
    match /staffProfiles/{userId} {
      allow read: if isClinicAdmin() || (request.auth != null && request.auth.uid == userId);
      // Staff lifecycle state mirrors Firebase Authentication custom claims and is
      // written only by the trusted manageStaffAccount Function. Browser writes
      // could otherwise desynchronise the directory from real access.
      allow create, update, delete: if false;
    }
    // Operational clinic preferences are deliberately private to the administrator.
    match /clinicSettings/{settingId} {
      allow read, write: if isClinicAdmin();
    }
    // Patient profiles are private to the patient and the administrator. Managers use
    // the audited server-side registry search, while doctors access only the clinical
    // subcollections below. This prevents browser-wide profile enumeration.
    match /patients/{patientId} {
      allow read: if isClinicAdmin() || (request.auth != null && request.auth.uid == patientId);
      // Profile writes go through callables so the private administrator directory
      // remains in sync. Clinical records stay staff-only.
      allow create, update, delete: if false;
      match /medicalHistory/{entryId} {
        // Clinical history is not manager/admin data. Patient self-reported
        // fields live on the parent profile and only doctors can modify clinical history.
        allow read: if isDoctor() || (request.auth != null && request.auth.uid == patientId);
        allow create, update, delete: if isDoctor();
      }
      match /medicalDocuments/{documentId} {
        // File metadata and bytes will be written only by a future server/Storage
        // workflow. Direct browser writes cannot establish an auditable upload.
        allow read: if isDoctor() || (request.auth != null && request.auth.uid == patientId);
        allow create, update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
