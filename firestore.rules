rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog records contain no patient data and power the demo booking flow.
    match /branches/{branchId} {
      // This collection is deliberately limited to public clinic details.
      allow read: if true;
      allow write: if false;
    }
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if false;
    }
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false;
    }
    // Visitors can submit, but can never read, alter, or delete appointments.
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasOnly(['branchId', 'departmentId', 'doctorId', 'startsAt', 'endsAt', 'reason', 'status', 'source', 'patient'])
        && request.resource.data.branchId is string
        && request.resource.data.departmentId is string
        && request.resource.data.doctorId is string
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.status == 'scheduled'
        && request.resource.data.source == 'patient_portal'
        && request.resource.data.patient.name is string
        && request.resource.data.patient.phone is string
        && request.resource.data.patient.consentToTreatment == true;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
